		{"id":"4d5e6f7001000108","fromNode":"3c4d5e6f70010009","fromSide":"right","toNode":"3c4d5e6f7001000a","toSide":"left","label":"확인"},
		{"id":"4d5e6f7001000109","fromNode":"3c4d5e6f7001000b","fromSide":"top","toNode":"3c4d5e6f70010007","toSide":"bottom","label":"fallback"},
		{"id":"4d5e6f7001000110","fromNode":"3c4d5e6f7001000c","fromSide":"top","toNode":"3c4d5e6f70010007","toSide":"bottom","label":"전환기 구조"}
	]
}