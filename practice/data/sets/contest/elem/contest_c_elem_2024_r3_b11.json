                         "code":  "#include \u003cstdio.h\u003e\n\n#define M(A, B) (A \u003e B ? B : A)\n#define N(A, B) (A ^ B == 0)\n#define P(A, B) (A \u003e B ? A : B)\n\nint n, m;\nint mapp[8][8];\n\nint main(void) {\n    int f = 1;\n    scanf(\"%d %d\", \u0026n, \u0026m);\n    \n    for(int i=0 ; i\u003cn ; i++) {\n        for(int j=0 ; j\u003cm ; j++) {\n            scanf(\"%1d\", \u0026mapp[i][j]);\n        }\n    }\n\n    for(int k = M(n, m) ; k \u003e= 2 ; k--) {\n        for(int i=0 ; i\u003c=n-k ; i++) {\n            for(int j=0 ; j\u003c=m-k ; j++) {\n                if(N(N(mapp[i][j], mapp[i+k-1][j]),\n                    N(mapp[i][j+k-1], mapp[i+k-1][j+k-1]))) {\n                    f = P(f, k * k);\n                }\n            }\n        }\n    }\n\n    printf(\"%d\\n\", f);\n    return 0;\n}",
